# Snowflake Connection Configuration
# ===================================
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control!
#
# To use with Python:
#   pip install python-dotenv
#   Then load in your script: from dotenv import load_dotenv; load_dotenv()
#
# Or set as system environment variables:
#   Windows (PowerShell): $env:SNOWFLAKE_ACCOUNT = "your_account"
#   Windows (CMD):        set SNOWFLAKE_ACCOUNT=your_account
#   Unix/Mac:             export SNOWFLAKE_ACCOUNT=your_account

# Required - Your Snowflake account identifier
# Format: <account_identifier> or <account_identifier>.<region>
# Example: abc12345.us-east-1 or xy12345.east-us-2.azure
SNOWFLAKE_ACCOUNT=your_account_here

# Required - Your Snowflake username
SNOWFLAKE_USER=your_username_here

# Required - Your Snowflake password
SNOWFLAKE_PASSWORD=your_password_here

# Optional - Override defaults if needed
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=MANUFACTURING_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
