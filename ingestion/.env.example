# Snowflake Connection Configuration
# ===================================
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control!
#
# To use with Python:
#   pip install python-dotenv
#   Then load in your script: from dotenv import load_dotenv; load_dotenv()
#
# Or set as system environment variables:
#   Windows (PowerShell): $env:SNOWFLAKE_ACCOUNT = "ORG-ACCOUNT"
#   Unix/Mac:             export SNOWFLAKE_ACCOUNT="ORG-ACCOUNT"

# ========================================
# Required Credentials
# ========================================

# Your Snowflake account identifier
# Format: <org>-<account> (e.g., FYIUUJV-XJ40878)
# Find it: SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=ORG-ACCOUNT

# Your Snowflake username
# For SSO users, this is typically your email address
# Find it: SELECT CURRENT_USER();
SNOWFLAKE_USER=your_username_here

# ========================================
# Authentication (choose one method)
# ========================================

# OPTION 1: Key-Pair Authentication (recommended for automation)
# Generate keys: python ingestion/generate_keys.py
# Then register the public key in Snowflake
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8

# OPTION 2: Password Authentication (simpler for development)
# SNOWFLAKE_PASSWORD=your_password_here

# ========================================
# Optional - Override defaults if needed
# ========================================
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=MANUFACTURING_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
